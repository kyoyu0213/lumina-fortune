# このファイルを .env.local にコピーし、各値を設定してください（実値はコミットしないこと）

# Anthropic Claude API キー（占い・チャット生成に使用）
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API キー（任意）
OPENAI_API_KEY=sk-your-api-key-here

# Upstash Redis（レート制限・生成キャッシュに使用）
# https://console.upstash.com で作成し、REST URL / TOKEN を設定
# ローカルで動作確認する場合は .env.local にも設定が必要（Vercel本番は設定済み）
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# カレンダー再生成（/api/calendar/generate?force=1）の管理者シークレット
# force=1 のときのみ照合。ヘッダ x-admin-secret 優先、互換でクエリ ?key= も可。
# 値は任意の強いランダム文字列を自身で設定してください（実値はコミットしない）。
CALENDAR_ADMIN_SECRET=your-strong-random-secret
